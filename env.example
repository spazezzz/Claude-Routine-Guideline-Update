# Claude-Routine-Guideline-Update — Environment Variables
# Copy this file to .env for local development.
# For Claude Web Routine, set these in Settings → Routine → Environment.
# NEVER commit .env to version control.

# ── GitHub (required by both skills) ──────────────────────────────────────
# GitHub username or organisation that owns the target repository.
GITHUB_REPO_OWNER=your-github-username

# Repository name.
GITHUB_REPO_NAME=claude-routine-guideline-update

# ── Google Calendar (Calendar-Event-Check skill) ───────────────────────────
# Authentication is handled by the Google Calendar connector in claude.ai.
# No OAuth credentials needed here.
#
# Calendar ID to check.
# Use "primary" for the main calendar of the connected Google account,
# or a full calendar address like name@group.calendar.google.com.
# Leave blank (or omit) to default to "primary".
GOOGLE_CALENDAR_ID=primary

# ── LINE Messaging API (optional — used by both skills) ────────────────────
# If these are absent, the LINE notification step is skipped.
# The skill still completes its primary action normally.

# Channel access token from LINE Developers Console → Messaging API.
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Recipient: LINE User ID (U...) or Group ID (C...) or Room ID (R...).
LINE_TO=your_line_user_or_group_id_here
