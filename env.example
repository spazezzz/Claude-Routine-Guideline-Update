# Claude-Routine-Guideline-Update — Environment Variables
# Copy this file to .env for local development.
# For Claude Web Routine, set these in Settings → Routine → Environment.
# NEVER commit .env to version control.

# ── GitHub (required by both skills) ──────────────────────────────────────
# GitHub username or organisation that owns the target repository.
GITHUB_REPO_OWNER=your-github-username

# Repository name.
GITHUB_REPO_NAME=claude-routine-guideline-update

# ── LINE Messaging API (optional — used by both skills) ───────────────────
# If these are absent, the LINE notification step is skipped.
# The skill will still complete its primary action normally.

# Channel access token from LINE Developers Console → Messaging API.
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Recipient: LINE User ID (U...) or Group ID (C...) or Room ID (R...).
LINE_TO=your_line_user_or_group_id_here

# ── Google Calendar API (required by Calendar-Event-Check skill) ──────────
# Calendar ID to check. Use "primary" for the main calendar of the
# authenticated account, or a full address like name@group.calendar.google.com
GOOGLE_CALENDAR_ID=primary

# OAuth 2.0 Client ID from Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# OAuth 2.0 Client Secret (keep this value secret).
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Long-lived offline refresh token obtained once via the OAuth consent flow.
# Scope required: https://www.googleapis.com/auth/calendar.readonly
# This token does not expire unless revoked; generate it once and store it here.
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
