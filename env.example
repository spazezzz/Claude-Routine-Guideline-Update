# Claude-Routine-Guideline-Update — Environment Variables
# Copy this file to .env for local development.
# For Claude Web Routine, set these in Settings → Routine → Environment.
# NEVER commit .env to version control.

# ── GitHub (required) ──────────────────────────────────────────────────────
# GitHub username or organisation that owns the target repository.
GITHUB_REPO_OWNER=your-github-username

# Repository name where articles will be committed.
GITHUB_REPO_NAME=claude-routine-guideline-update

# ── LINE Messaging API (optional) ──────────────────────────────────────────
# If these are absent, the LINE notification step is skipped.
# The skill will still commit the article to GitHub normally.

# Channel access token from LINE Developers Console → Messaging API.
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Recipient: LINE User ID (U...) or Group ID (C...) or Room ID (R...).
LINE_TO=your_line_user_or_group_id_here
